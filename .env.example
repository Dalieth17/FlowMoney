# Copia este archivo a .env (no se sube a git) y ajusta los valores.
# docker compose los lee automáticamente.

# Puerto público del sitio
WEB_PORT=8080

# Puerto de MySQL en tu equipo (solo 127.0.0.1), para Workbench/DBeaver.
# Evita el 3306 si ya tienes un MySQL instalado; si el 3307 también está ocupado, pon otro (p. ej. 3310).
MYSQL_PORT=3307

# MySQL
MYSQL_ROOT_PASSWORD=cambia-esta-clave
DB_NAME=flowmoney
DB_USER=flowmoney
DB_PASSWORD=cambia-esta-clave

# true solo si sirves el sitio por HTTPS
COOKIE_SECURE=false
