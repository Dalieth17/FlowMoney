# Copia este archivo a .env y ajusta los valores para producción.
# docker compose los toma automáticamente.

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=flowmoney
DB_USER=flowmoney
DB_PASSWORD=flowmoney

# Seguridad de la API
# Genera uno con: openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me
