# Copia este archivo a .env (no se sube a git) y ajusta los valores.
# docker compose los lee automáticamente.

# Puerto público del sitio
WEB_PORT=8080

# Puerto de MySQL en tu equipo (solo 127.0.0.1), para Workbench/DBeaver.
# Evita el 3306 si ya tienes un MySQL instalado; si el 3309 también está ocupado, pon otro (p. ej. 3310).
MYSQL_PORT=3309

# MySQL
MYSQL_ROOT_PASSWORD=cambia-esta-clave
DB_NAME=flowmoney
DB_USER=flowmoney
DB_PASSWORD=cambia-esta-clave

# true solo si sirves el sitio por HTTPS
COOKIE_SECURE=false

# En producción: NODE_ENV=production, HTTPS en el proxy exterior y COOKIE_SECURE=true.
# DB_PASSWORD debe tener al menos 16 caracteres y no ser un valor de ejemplo.
NODE_ENV=development
