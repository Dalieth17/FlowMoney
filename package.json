{
  "name": "flowmoney",
  "version": "1.1.0",
  "private": true,
  "description": "FlowMoney — finanzas personales. Herramientas de calidad del monorepo (lint, formato, tests).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:web": "node --test \"apps/web/tests/*.test.js\"",
    "test:api": "npm --prefix apps/api test",
    "test:integration": "npm --prefix apps/api run test:integration",
    "test": "npm run test:web && npm run test:api",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "linkedom": "0.18.12",
    "prettier": "3.4.2"
  }
}
