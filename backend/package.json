{
  "name": "flowmoney-api",
  "version": "1.1.0",
  "private": true,
  "description": "API REST de FlowMoney: Express + MySQL con autenticación de usuarios.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "mysql2": "3.11.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "supertest": "7.1.4"
  }
}
